# file binari: Git non deve mai toccarne i byte (niente conversione dei fine riga)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary

# archivio legale: copie di prova con impronte SHA-256 (MANIFEST.txt), Git non deve modificarne i byte
trust-src/archivio/** -text
